# sioyek user preferences
# Docs: https://sioyek-documentation.readthedocs.io/en/latest/configuration.html

# --- appearance ---
custom_background_color 1.0 1.0 1.0
custom_text_color 0.0 0.0 0.0
background_color 1.0 1.0 1.0
# no-op on sioyek 2.0.0 (option only exists in newer builds), kept for forward compat
custom_color_mode_empty_background_color 1.0 1.0 1.0
fit_to_page_width_ratio 1.0
ui_font JetBrainsMono Nerd Font

# --- startup (applied when sioyek launches) ---
startup_commands toggle_custom_color;toggle_titlebar;toggle_visual_scroll
